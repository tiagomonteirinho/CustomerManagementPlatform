@model AppCalisto.Data.Entities.Appointment
@{
    ViewData["Title"] = "Appointment details";
}

<h2>Order #@Model.Id.ToString("D4")</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Id.ToString("D4")</dd>
        <dt class="col-sm-2">Order</dt>
        <dd class="col-sm-10">Order #@Model.OrderId.ToString("D4")</dd>
        <dt class="col-sm-2">Technician</dt>
        <dd class="col-sm-10">@Model.Technician.Name</dd>
        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
        <dt class="col-sm-2">Start time</dt>
        <dd class="col-sm-10">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-2">End time</dt>
        <dd class="col-sm-10">@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>
