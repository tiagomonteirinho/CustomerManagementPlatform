@model AppCalisto.Models.OrderViewModel;
@{
    ViewData["Title"] = "Create new order";
}

<h2>Create new order</h2>
<hr />
@if (ViewBag.Success != null)
{
    <div class="alert alert-success">
        @ViewBag.Success
    </div>
}
@if (ViewBag.Failure != null)
{
    <div class="alert alert-danger">
        @ViewBag.Failure
    </div>
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="ClientId" />

            <div class="form-group">
                <label asp-for="Number">Number</label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Type">Type</label>
                <input asp-for="Type" class="form-control" />
                <span asp-validation-for="Type" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location">Location</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status">Status</label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-warning"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-secondary">Back to list</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
