@model AppCalisto.Data.Entities.Order
@{
    ViewData["Title"] = "Details";
}

<h2>Order #@Model.Id.ToString("D4")</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Id.ToString("D4")</dd>
        <dt class="col-sm-2">Client</dt>
        <dd class="col-sm-10">
            <a asp-controller="Clients" asp-action="Details" asp-route-Id="@Model.ClientId">@Model.Client.Name</a>
        </dd>
        <dt class="col-sm-2">Company</dt>
        <dd class="col-sm-10">
            <a asp-controller="Companies" asp-action="Details" asp-route-Id="@Model.Service.CompanyId">@Model.Service.Company.Name</a>
        </dd>
        <dt class="col-sm-2">Service</dt>
        <dd class="col-sm-10">
            <a asp-controller="Services" asp-action="Details" asp-route-Id="@Model.ServiceId">@Model.Service.Name</a>
        </dd>
        <dt class="col-sm-2">Technician</dt>
        <dd class="col-sm-10">
            <a asp-controller="Users" asp-action="Details" asp-route-Id="@Model.TechnicianId">@Model.Technician.Name</a>
        </dd>
        <dt class="col-sm-2">Creation</dt>
        <dd class="col-sm-10">@Model.Creation</dd>
        <dt class="col-sm-2">Urgent</dt>
        <dd class="col-sm-10">@(Model.IsUrgent ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Appointment</dt>
        <dd class="col-sm-10">
            @if (Model.Appointment > Model.Creation)
            {
                @Model.Appointment
            }
        </dd>
        <dt class="col-sm-2">Execution</dt>
        <dd class="col-sm-10">
            @if (Model.Execution > Model.Creation)
            {
                @Model.Execution
            }
        </dd>
        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Description?.Replace("\n", "<br />"))</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>