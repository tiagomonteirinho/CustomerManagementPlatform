@model AppCalisto.Data.Entities.Order
@{
    ViewData["Title"] = "Details";
}

<h2>Order #@Model.Id.ToString("D4")</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Id.ToString("D4")</dd>
        <dt class="col-sm-2">Client</dt>
        <dd class="col-sm-10">@Model.Client.Name</dd>
        <dt class="col-sm-2">Company</dt>
        <dd class="col-sm-10">@Model.Service.Company.Name</dd>
        <dt class="col-sm-2">Service</dt>
        <dd class="col-sm-10">@Model.Service.Name</dd>
        <dt class="col-sm-2">Creation</dt>
        <dd class="col-sm-10">@Model.Creation</dd>
        <dt class="col-sm-2">Urgent</dt>
        <dd class="col-sm-10">@(Model.IsUrgent ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Appointment</dt>
        <dd class="col-sm-10">
            @if (Model.Appointment > Model.Creation)
            {
                @Model.Appointment
            }
        </dd>
        <dt class="col-sm-2">Execution</dt>
        <dd class="col-sm-10">
            @if (Model.Execution > Model.Creation)
            {
                @Model.Execution
            }
        </dd>
        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Description?.Replace("\n", "<br />"))</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="IndexTechnicianOrders" class="btn btn-secondary">Back to list</a>
</div>

<div class="form-group">
    <h3>Budgets</h3>
    <a asp-controller="Budgets" asp-action="Create" asp-route-OrderId="@Model.Id" class="btn btn-primary">Add new budget</a>
</div>
@if (Model.Budgets == null || Model.Budgets.Count == 0)
{
    <h5>This order does not contain any budgets.</h5>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover table-responsive-lg" id="MyTable">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Budgets.OrderBy(i => i.Id))
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Description</td>
                                    <td>@item.Status</td>
                                    <td>
                                        <a asp-controller="Budgets" asp-action="DetailTechnicianBudget" asp-route-Id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}
