@model IEnumerable<AppCalisto.Data.Entities.Order>
@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />

<h2>All orders</h2>
<br />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Failure"] != null)
{
    <div class="alert alert-danger">
        @TempData["Failure"]
    </div>
}

<a asp-controller="Clients" asp-action="Index" class="btn btn-primary">Create new order</a>
<br />
<br />

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-hover table-responsive" id="MyTable">
                    <thead>
                        <tr>
                            <th>Number</th>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Technician</th>
                            <th>Created</th>
                            <th>Urgent</th>
                            <th>Appointment</th>
                            <th>Location</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id.ToString("D4")</td>
                                <td>
                                    <a asp-controller="Clients" asp-action="Details" asp-route-Id="@item.Client.Id">@item.Client.Name</a>
                                </td>
                                <td>
                                    <a asp-controller="Services" asp-action="Details" asp-route-Id="@item.Service.Id">@item.Service.Abbreviation</a>
                                </td>
                                <td>
                                    <a asp-controller="Users" asp-action="Details" asp-route-Id="@item.TechnicianId">@item.Technician.Name</a>
                                </td>
                                <td>@item.Creation</td>
                                <td>
                                    @(item.IsUrgent ? "Yes" : "No")
                                </td>
                                <td>
                                    @if (item.Appointment > item.Creation)
                                    {
                                        @item.Appointment
                                    }
                                </td>
                                <td>@item.Location</td>
                                <td>
                                    <a asp-action="Details" asp-route-Id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}
