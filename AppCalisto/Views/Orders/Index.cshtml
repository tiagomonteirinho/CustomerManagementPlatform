@model IEnumerable<AppCalisto.Data.Entities.Order>
@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />

<h2>All orders</h2>
<br />

<a asp-controller="Clients" asp-action="Index" class="btn btn-primary">Create new order</a>
<br />
<br />

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-hover table-responsive" id="MyTable">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Number</th>
                            <th>Client</th>
                            <th>Company</th>
                            <th>Urgent</th>
                            <th>Appointment</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(i => i.Id))
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Number</td>
                                <td>
                                    <a asp-controller="Clients" asp-action="Details" asp-route-id="@item.Client.Id">@item.Client.Name (ID @item.Client.Id)</a>
                                </td>
                                <td>@item.Company</td>
                                <td>
                                    @(item.IsUrgent ? "Yes" : "No")
                                </td>
                                <td>
                                    @if (item.Appointment >= item.Creation)
                                    {
                                        @item.Appointment
                                    }
                                </td>
                                <td>@item.Type</td>
                                <td>@item.Location</td>
                                <td>@item.Status</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable();
        });
    </script>
}
