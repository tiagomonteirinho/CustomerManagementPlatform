@model AppCalisto.Models.BudgetViewModel
@{
    ViewData["Title"] = "Budget details";
}

<h2>Budget #@Model.Id.ToString("D4")</h2>
<hr />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Failure"] != null)
{
    <div class="alert alert-danger">
        @TempData["Failure"]
    </div>
}

<h4 class="mt-3">
    Budget total:
    <strong>
        @Model.Total.ToString("0.00")€
    </strong>
</h4>
<br />

<div class="mb-3">
    <a asp-action="AddProduct" asp-route-budgetId="@Model.Id" class="btn btn-success">Add product</a>
</div>
@if (Model.Items == null || !Model.Items.Any())
{
    <div class="alert alert-warning">This budget does not contain any products.</div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover table-responsive-lg" id="MyTable">
                        <thead class="thead-light">
                            <tr>
                                <th>Name</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Product.Name</td>
                                    <td>@item.Product.UnitPrice.ToString("0.00")€</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Total.ToString("0.00")€</td>
                                    <td>
                                        <a asp-action="IncreaseProductQuantity" asp-route-id="@item.Id" class="btn btn-sm btn-success">+</a>
                                        <a asp-action="DecreaseProductQuantity" asp-route-id="@item.Id" class="btn btn-sm btn-warning">-</a>
                                        <a asp-action="RemoveProduct" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Remove</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}
