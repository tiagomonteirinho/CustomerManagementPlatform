@model AppCalisto.Data.Entities.Budget
@{
    ViewData["Title"] = "Details";
}

<h2>Budget #@Model.Id.ToString("D4")</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Id.ToString("D4")</dd>
        <dt class="col-sm-2">Order</dt>
        <dd class="col-sm-10">Order #@Model.OrderId</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Description?.Replace("\n", "<br />"))</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="IndexTechnicianBudgets" class="btn btn-secondary">Back to list</a>
</div>

<div class="form-group">
    <h3>Products</h3>
</div>
@if (Model.BudgetProducts == null || Model.BudgetProducts.Count == 0)
{
    <h5>This budget does not contain any products.</h5>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover table-responsive-lg" id="MyTable">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Tax</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BudgetProducts.OrderBy(i => i.ProductId))
                            {
                                <tr>
                                    <td>@item.ProductId.ToString("D4")</td>
                                    <td>@item.Product.Name</td>
                                    <td>@item.Product.Price€</td>
                                    <td>@item.Product.Tax%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}
