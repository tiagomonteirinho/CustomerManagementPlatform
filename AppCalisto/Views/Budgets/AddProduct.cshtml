@model AppCalisto.Models.ItemViewModel

@{
    ViewData["Title"] = "Select a product";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />
<style>
    td {
        word-break: break-word;
        word-wrap: break-word;
        white-space: normal;
        max-width: 300px;
    }
</style>

<h2>Select a product to add</h2>
<br />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Failure"] != null)
{
    <div class="alert alert-danger">
        @TempData["Failure"]
    </div>
}

<h4 class="mt-3">
    Service:
    <strong>
        @Model.Budget.Order.Service.Name
    </strong>
</h4>
<br />
<form asp-action="AddProduct" method="post" id="addProductForm">
    <input type="hidden" asp-for="OrderId" />
    <input type="hidden" asp-for="ProductId" />

    <div class="form-group mb-3">
        <h4 asp-for="Quantity">Quantity:</h4>
        <input asp-for="Quantity" type="number" value="1" min="1" class="form-control" style="width: 100px;" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover table-responsive-lg" id="MyTable">
                        <thead class="thead-light">
                            <tr>
                                <th>Name</th>
                                <th>Unit Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.SelectableProducts)
                            {
                                <tr>
                                    <td>@product.Name</td>
                                    <td>@product.UnitPrice.ToString("0.00")€</td>
                                    <td>
                                        <button type="button" class="btn btn-primary select-product" data-product-id="@product.Id">Add</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>

    <script>
        document.querySelectorAll('.select-product').forEach(button => {
            button.addEventListener('click', function () {
                const productId = this.dataset.productId;
                document.querySelector('input[name="ProductId"]').value = productId;
                document.getElementById('addProductForm').submit();
            });
        });
    </script>
}
