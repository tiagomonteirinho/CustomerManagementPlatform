@model AppCalisto.Data.Entities.Service
@{
    ViewData["Title"] = "Details";
}

<h2>@Model.Name</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Abbreviation</dt>
        <dd class="col-sm-10">@Model.Abbreviation</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Company</dt>
        <dd class="col-sm-10">
            <a asp-controller="Companies" asp-action="Details" asp-route-Id="@Model.Company.Id">@Model.Company.Name (ID @Model.Company.Id)</a>
        </dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>