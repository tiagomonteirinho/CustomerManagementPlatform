@model AppCalisto.Models.UserViewModel;
@{
    ViewData["Title"] = "Edit user";
}

<h2>@Model.Name</h2>
<hr />
@if (ViewBag.Success != null)
{
    <div class="alert alert-success">
        @ViewBag.Success
    </div>
}
@if (ViewBag.Failure != null)
{
    <div class="alert alert-danger">
        @ViewBag.Failure
    </div>
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label>Roles</label>
                @foreach (var role in Model.SelectableRoles ?? new List<SelectListItem>())
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="Roles" value="@role.Value" @(Model.Roles?.Contains(role.Value) ?? false ? "checked" : "") />
                        <label class="form-check-label">@role.Text</label>
                    </div>
                }
                <span asp-validation-for="Roles" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-warning"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save changes" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to details</a>
            </div>
        </form>
        <div class="form-group">
            @if (!(Model.Roles ?? new List<string>()).Contains("Admin"))
            {
                @if (Model.LockoutEnd == null || Model.LockoutEnd < DateTimeOffset.Now)
                {
                    <form method="post" asp-action="Deactivate">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="submit" value="Deactivate user" class="btn btn-danger" onclick="return confirm('Are you sure you want to deactivate this user?');" />
                    </form>
                }
                else
                {
                    <form method="post" asp-action="Reactivate">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="submit" value="Reactivate user" class="btn btn-success" onclick="return confirm('Are you sure you want to reactivate this user?');" />
                    </form>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
