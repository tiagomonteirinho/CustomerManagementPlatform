@model AppCalisto.Data.Entities.User
@{
    ViewData["Title"] = "Details";
}

<h2>@Model.Name</h2>
<hr />
@if (ViewBag.Success != null)
{
    <div class="alert alert-success">
        @ViewBag.Success
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Roles</dt>
        <dd class="col-sm-10">
            @string.Join(", ", Model.Roles ?? new List<string>())
        </dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => Model.Name)
        </dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => Model.Email)
        </dd>
        <dt class="col-sm-2">Email confirmed</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => Model.EmailConfirmed)
        </dd>
        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">
            @if ((Model.Roles ?? new List<string>()).Contains("Admin"))
            {
                <p>Always</p>
            }
            else
            {
                <div class="form-check">
                    @if (Model.LockoutEnd == null || Model.LockoutEnd < DateTimeOffset.Now)
                    {
                        <input type="checkbox" disabled checked="checked" class="form-check-input" />
                    }
                    else
                    {
                        <input type="checkbox" disabled class="form-check-input" />
                    }
                </div>
            }
        </dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>
