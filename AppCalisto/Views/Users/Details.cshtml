@model AppCalisto.Data.Entities.User
@{
    ViewData["Title"] = "Details";
}

<h2>@Model.Name</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Roles</dt>
        <dd class="col-sm-10">@string.Join(", ", Model.Roles ?? new List<string>())</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Email confirmed</dt>
        <dd class="col-sm-10">
            @(Model.EmailConfirmed ? "Yes" : "No")
        </dd>
        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">
            @((Model.Roles ?? new List<string>()).Contains("Admin")
                ? "Always"
                : (Model.LockoutEnd == null || Model.LockoutEnd < DateTimeOffset.Now) ? "Yes" : "No")
        </dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>
