@model IEnumerable<AppCalisto.Data.Entities.User>
@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />

<h2>All users</h2>
<br />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Failure"] != null)
{
    <div class="alert alert-danger">
        @TempData["Failure"]
    </div>
}

<a asp-action="Create" class="btn btn-primary">Create new user</a>
<br />
<br />

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-hover table-responsive-lg" id="MyTable">
                    <thead>
                        <tr>
                            <th>Roles</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Email confirmed</th>
                            <th>Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(i => i.Name))
                        {
                            <tr>
                                <td>@string.Join(", ", item.Roles ?? new List<string>())</td>
                                <td>@item.Name</td>
                                <td>@item.Email</td>
                                <td>
                                    @(item.EmailConfirmed ? "Yes" : "No")
                                </td>
                                <td>
                                    @((item.LockoutEnd == null || item.LockoutEnd < DateTimeOffset.Now) ? "Yes" : "No")
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-Id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable();
        });
    </script>
}
