@model AppCalisto.Models.UserViewModel;
@{
    ViewData["Title"] = "Create new user";
}

<h2>Create new user</h2>
<hr />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Failure"] != null)
{
    <div class="alert alert-danger">
        @TempData["Failure"]
    </div>
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label>Roles</label>
                @foreach (var role in Model.SelectableRoles)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input role-checkbox" id="role-@role.Value" name="Roles" value="@role.Value" onchange="toggleCompanyList()" />
                        <label class="form-check-label">@role.Text</label>
                    </div>
                }
                <span asp-validation-for="Roles" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-warning"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to list</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleCompanyList() {
            var frontOfficeChecked = document.querySelector('input[value="Front-office"]:checked');
            var companySelectionDiv = document.getElementById("companySelection");

            if (frontOfficeChecked) {
                companySelectionDiv.style.display = "block";
            } else {
                companySelectionDiv.style.display = "none";
            }
        }

        // Run once on page load in case Front-office is preselected
        document.addEventListener("DOMContentLoaded", toggleCompanyList);
    </script>
}
