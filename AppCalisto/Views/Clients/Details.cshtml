@model CustomerManagementPlatform.Data.Entities.Client
@{
    ViewData["Title"] = "Details";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />

<h2>@Model.Name</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Id.ToString("D4")</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Contact person</dt>
        <dd class="col-sm-10">@Model.ContactPerson</dd>
        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>
        <dt class="col-sm-2">Zip code</dt>
        <dd class="col-sm-10">@Model.ZipCode</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
        <dt class="col-sm-2">TIN</dt>
        <dd class="col-sm-10">@Model.Tin</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>

<div class="form-group">
    <h3>Orders</h3>
    <a asp-controller="Orders" asp-action="Create" asp-route-ClientId="@Model.Id" class="btn btn-primary">Add new order</a>
</div>
@if (Model.Orders == null || Model.Orders.Count == 0)
{
    <div class="alert alert-warning">This client does not contain any orders.</div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover table-responsive" id="MyTable">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Company</th>
                                <th>Service</th>
                                <th>Technician</th>
                                <th>Urgent</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Orders.OrderBy(i => i.Id))
                            {
                                <tr>
                                    <td>@item.Id.ToString("D4")</td>
                                    <td>
                                        <a asp-controller="Companies" asp-action="Details" asp-route-Id="@item.Service.CompanyId">@item.Service.Company.Abbreviation</a>
                                    </td>
                                    <td>
                                        <a asp-controller="Services" asp-action="Details" asp-route-Id="@item.Service.Id">@item.Service.Abbreviation</a>
                                    </td>
                                    <td>
                                        <a asp-controller="Users" asp-action="Details" asp-route-Id="@item.TechnicianId">@item.Technician.Name</a>
                                    </td>
                                    <td>
                                        @(item.IsUrgent ? "Yes" : "No")
                                    </td>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-Id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}
