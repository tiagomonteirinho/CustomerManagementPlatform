@model AppCalisto.Data.Entities.Product
@{
    ViewData["Title"] = "Details";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />

<h2>Product #@Model.Id.ToString("D4")</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id.ToString("D4")</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price€</dd>
        <dt class="col-sm-2">Tax</dt>
        <dd class="col-sm-10">@Model.Tax.ToString("0")%</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>
