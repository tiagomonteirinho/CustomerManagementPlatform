@model AppCalisto.Data.Entities.Company
@{
    ViewData["Title"] = "Details";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css" />

<h2>@Model.Name</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Abbreviation</dt>
        <dd class="col-sm-10">@Model.Abbreviation</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>
</div>
<div class="form-group">
    <a asp-action="Edit" asp-route-Id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>

<div class="form-group">
    <h3>Services</h3>
    <a asp-controller="Services" asp-action="Create" asp-route-CompanyId="@Model.Id" class="btn btn-primary">Add new service</a>
</div>
@if (Model.Services == null || Model.Services.Count == 0)
{
    <h5>This company does not contain any services.</h5>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover table-responsive-lg" id="MyTable">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Abbreviation</th>
                                <th>Name</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Services.OrderBy(i => i.Id))
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Abbreviation</td>
                                    <td>@item.Name</td>
                                    <td>
                                        <a asp-controller="Services" asp-action="Details" asp-route-Id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#MyTable').DataTable({
                "order": [[0, "desc"]]
            });
        });
    </script>
}
