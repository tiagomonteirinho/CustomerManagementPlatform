@model CustomerManagementPlatform.Models.OrderViewModel;
@{
    ViewData["Title"] = "Edit order";
}

<h2>Order #@Model.Id.ToString("D4")</h2>
<hr />
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Failure"] != null)
{
    <div class="alert alert-danger">
        @TempData["Failure"]
    </div>
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="ClientId" />

            <div class="form-group">
                <label asp-for="CompanyId">Company</label>
                <select asp-for="CompanyId" asp-items="Model.SelectableCompanies" class="form-control" id="companyDropdown"></select>
                <span asp-validation-for="CompanyId" class="text-warning"></span>
            </div>
            <div class="form-group" id="serviceForm" style="display:none;">
                <label asp-for="ServiceId">Service</label>
                <select asp-for="ServiceId" asp-items="Model.SelectableServices" class="form-control" id="serviceDropdown"></select>
                <span asp-validation-for="ServiceId" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="TechnicianId">Technician</label>
                <select asp-for="TechnicianId" asp-items="Model.SelectableTechnicians" class="form-control"></select>
                <span asp-validation-for="TechnicianId" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsUrgent">Urgent</label>
                <input asp-for="IsUrgent" class="form-control" />
                <span asp-validation-for="IsUrgent" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status">Status</label>
                <textarea asp-for="Status" class="form-control" rows="3" maxlength="99"></textarea>
                <span asp-validation-for="Status" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClientDescription">Client Description</label>
                <textarea asp-for="ClientDescription" class="form-control" rows="3" maxlength="299"></textarea>
                <span asp-validation-for="ClientDescription" class="text-warning"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save changes" class="btn btn-primary" />
                <a asp-action="Details" asp-route-Id="@Model.Id" class="btn btn-secondary">Back to details</a>
            </div>
        </form>
        @if (!Model.IsClosed)
        {
            <div class="form-group">
                <form method="post" asp-action="Delete">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="submit" value="Delete order" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this order?');" />
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    @* Service selection *@
    <script>
        $(document).ready(function () {
            var $companyDropdown = $('#companyDropdown');
            var $serviceDropdown = $('#serviceDropdown');
            var $serviceForm = $('#serviceForm');
            var currentServiceId = '@Model.ServiceId';

            function loadServices(companyId, preselectServiceId) {
                $serviceDropdown.empty();

                if (companyId) {
                    $serviceForm.show();
                    $.ajax({
                        url: '/Orders/GetCompanyServices',
                        type: 'GET',
                        data: { companyId: companyId },
                        success: function (data) {
                            $.each(data, function (i, item) {
                                var option = $('<option>', {
                                    value: item.value,
                                    text: item.text
                                });

                                if (item.value == preselectServiceId) {
                                    option.prop('selected', true);
                                }

                                $serviceDropdown.append(option);
                            });
                        },
                        error: function () {
                            alert('Error loading services. Please try again.');
                        }
                    });
                } else {
                    $serviceForm.hide();
                }
            }

            // Initial check.
            var initialCompanyId = $companyDropdown.val();
            if (initialCompanyId) {
                $serviceForm.show();
                // Only reload via AJAX if services were NOT passed via model.
                if ($serviceDropdown.children().length <= 1) {
                    loadServices(initialCompanyId, currentServiceId);
                }
            }

            // Update services dropdown on company change.
            $companyDropdown.on('change', function () {
                var selectedCompanyId = $(this).val();
                loadServices(selectedCompanyId, null);
            });
        });
    </script>
}
